# Supabase — copie para .env.local e preencha.
# Local (supabase start): use os valores impressos pelo CLI.
# Produção: Project Settings → API no dashboard do Supabase.
# IMPORTANTE: crie o projeto na região sa-east-1 (São Paulo) — LGPD.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas server-side (webhooks, jobs). NUNCA expor no client.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional — Resend (https://resend.com/api-keys)
# Sem chave, roda em modo dev (loga no console, registra em message_logs).
# RESEND_API_KEY=re_...
# EMAIL_FROM="PSYSTEM <notificacoes@seudominio.com.br>"   # domínio verificado no Resend

# Provedores pendentes (ver docs/prd.md)
# MESSAGE_PROVIDER=          # whatsapp: 360dialog | twilio | zapi
# PAYMENT_GATEWAY=           # asaas | mercadopago
# INVOICE_PROVIDER=          # enotas | focusnfe | nfeio
